# Copy this file to .env and change the values.

PORT=3000
NODE_ENV=development

# Use a long random string in production, for example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

DB_PATH=./data/parcelhub.db
UPLOAD_DIR=./data/uploads

# true = the login code is returned to the app so you can test without SMS.
# Set to false in production.
DEV_SHOW_OTP=true

# console = print messages in the server log (no real sending)
# twilio  = send real WhatsApp and SMS messages through Twilio
MESSAGE_PROVIDER=console

# Only needed when MESSAGE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox WhatsApp number for testing: +14155238886
TWILIO_WHATSAPP_FROM=+14155238886
# A Twilio number that can send SMS (used for login codes)
TWILIO_SMS_FROM=
